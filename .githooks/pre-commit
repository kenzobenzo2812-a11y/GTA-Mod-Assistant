#!/usr/bin/env bash
set -euo pipefail

# GTA Mod Assistant — Pre-Commit Secret & Key Guard
# Blocks commits containing API keys, .env files, DPAPI secrets, or Rockstar key files.

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "${STAGED_FILES}" ]]; then
  exit 0
fi

# 1. Block forbidden secret/key filenames even if force-added with git add -f
FORBIDDEN_FILE_REGEX='(^|/)\.env(\..+)?$|\.dpapi$|\.key$|\.pem$|\.pfx$|\.p12$|\.secret$|(^|/)secrets\.json$|(^|/)GTAModAssistant_Data/|ng_key|aes_key|(^|/)keys\.dat$'
if echo "${STAGED_FILES}" | grep -Eiq "${FORBIDDEN_FILE_REGEX}"; then
  echo "[BLOCKED BY SECRET GUARD] Forbidden key/secret file staged for commit:" >&2
  echo "${STAGED_FILES}" | grep -Ei "${FORBIDDEN_FILE_REGEX}" >&2
  echo "Unstage with: git reset HEAD <file>" >&2
  exit 1
fi

# 2. Scan staged diff content for live API keys / tokens
SECRET_CONTENT_REGEX='(sk-(proj-|live-|test-)?[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}|ghp_[A-Za-z0-9]{25,}|github_pat_[A-Za-z0-9_]{30,}|glpat-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|(GTAMA_AI_API_KEY|OPENAI_API_KEY|ANTHROPIC_API_KEY)[[:space:]]*=[[:space:]]*["'\'']?[A-Za-z0-9._-]{12,})'
if git diff --cached -U0 | grep -E "^\\+" | grep -Ev "^\\+\\+\\+" | grep -Eq "${SECRET_CONTENT_REGEX}"; then
  echo "[BLOCKED BY SECRET GUARD] Potential API key or secret token detected in staged diff!" >&2
  echo "Store keys in Windows DPAPI (UI Settings) or environment variables (GTAMA_AI_API_KEY) — never in tracked files." >&2
  exit 1
fi

exit 0
