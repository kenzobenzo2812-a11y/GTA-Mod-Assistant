<Window x:Class="GTAModAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA Mod Assistant — AI Single-Player Mod Manager"
        Width="1320"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragEnter="OnWindowDragEnter"
        PreviewDragOver="OnWindowDragOver"
        PreviewDragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="Assets/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP BRANDING + COMMAND TOOLBAR + PROFILE SWITCHER -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Title + Profile Switcher + AI Settings -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#064E3B" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="1.5" Margin="0,0,12,0">
                            <TextBlock Text="G" FontWeight="ExtraBold" FontSize="19" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GTA MOD ASSISTANT" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border Background="#064E3B" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersionBadge, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="AI-Powered GTA V Single-Player Mod Manager  •  RPF7 &amp; OpenIV Verified" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Active Profile:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,6,0" />
                        <Button Content="+ Profile"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6"
                                Margin="0,0,6,0"
                                Command="{Binding CreateProfileCommand}" />
                        <Button Content="Delete Profile"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6"
                                Margin="0,0,12,0"
                                Command="{Binding DeleteProfileCommand}" />
                        <Button Content="AI &amp; Safety Settings"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Command="{Binding ShowAiSettingsCommand}" />
                    </StackPanel>
                </DockPanel>

                <!-- Second Row: Primary Required Action Buttons -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="Scan Game"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,4"
                            Command="{Binding ScanGameCommand}" />
                    <Button Content="Add Mod"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,6,4"
                            Command="{Binding AddModFileCommand}" />
                    <Button Content="Add Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,12,4"
                            Command="{Binding AddModFolderCommand}" />
                    <Button Content="Install"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,12,4"
                            Command="{Binding InstallModCommand}" />
                    <Button Content="Backup"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,6,4"
                            Command="{Binding CreateBackupCommand}" />
                    <Button Content="Restore"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,16,4"
                            Command="{Binding RestoreBackupCommand}" />

                    <!-- Workspace View Switchers -->
                    <Border Width="1" Height="24" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,14,4" />
                    <Button Content="Mod Analyzer &amp; Plan"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,4"
                            Command="{Binding ShowAnalyzerTabCommand}" />
                    <Button Content="Installed Mods"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,4"
                            Command="{Binding ShowInstalledModsCommand}" />
                    <Button Content="Memory &amp; Junk Cleanup"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,4"
                            Command="{Binding ShowCleanupTabCommand}" />
                    <Button Content="Logs"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,4"
                            Command="{Binding ShowLogsCommand}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ROW 1: VERIFICATION / STATUS BANNER -->
        <Border Grid.Row="1"
                Background="{Binding StatusBannerKind, Converter={StaticResource SeverityToBrush}}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,8">
            <DockPanel>
                <TextBlock Text="{Binding StatusBannerText}"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="12.8"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ROW 2: MAIN WORKSPACE CONTENT -->
        <Grid Grid.Row="2" Margin="18,14">

            <!-- ==================== VIEW 1: ANALYZER & INSTALLATION PLAN ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsAnalyzerTab, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Environment Detection Card -->
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="DETECTED GTA V ENVIRONMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding GameEnv.SummaryLine}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding GameEnv.GtaRootPath}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#CBD5E1">
                                    <Run Text="OpenIV: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Run Text="{Binding GameEnv.OpenIvExecutablePath, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <WrapPanel>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock FontSize="11.5" Foreground="#E2E8F0">
                                            <Run Text="mods/ folder: " Foreground="#94A3B8" />
                                            <Run Text="{Binding GameEnv.ModsFolderExists, Mode=OneWay}" FontWeight="Bold" />
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock FontSize="11.5" Foreground="#E2E8F0">
                                            <Run Text="OpenIV.asi: " Foreground="#94A3B8" />
                                            <Run Text="{Binding GameEnv.OpenIvAsiInstalled, Mode=OneWay}" FontWeight="Bold" />
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock FontSize="11.5" Foreground="#E2E8F0">
                                            <Run Text="dinput8.dll: " Foreground="#94A3B8" />
                                            <Run Text="{Binding GameEnv.AsiLoaderInstalled, Mode=OneWay}" FontWeight="Bold" />
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock FontSize="11.5" Foreground="#E2E8F0">
                                            <Run Text="ScriptHookV: " Foreground="#94A3B8" />
                                            <Run Text="{Binding GameEnv.ScriptHookVInstalled, Mode=OneWay}" FontWeight="Bold" />
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding GameEnv.HealthWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource AccentAmberBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="Set GTA V Folder..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseGtaFolderCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Drag & Drop Mod Zone -->
                    <Border Background="#111C2D"
                            BorderBrush="#2E4A6F"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="24,20"
                            Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Drag &amp; Drop Mod ZIP, RAR, OIV Package, 7Z, or Extracted Folder Here"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="AI reads the README, inspects RPF7 &amp; PE binary headers, checks GTA V build compatibility, and prepares a safe 'mods/' installation plan before changing anything."
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Browse Archive (.zip / .rar / .oiv / .7z)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Command="{Binding AddModFileCommand}" />
                                <Button Content="Browse Extracted Mod Folder"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AddModFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Staged Installation Plan Details -->
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Visibility="{Binding HasCurrentPlan, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding CurrentPlan}">
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding DataContext.PlanStatusHeadline, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding ModName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Version: " /><Run Text="{Binding ModVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                        <Run Text="   •   Author: " /><Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                        <Run Text="   •   Analyzer: " /><Run Text="{Binding AnalysisEngineUsed, Mode=OneWay}" Foreground="#CBD5E1" />
                                    </TextBlock>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,3,0,0"
                                               Visibility="{Binding SpawnNamesDisplay, Converter={StaticResource NullToVis}}">
                                        <Run Text="Detected In-Game Spawn / Model Name(s): " Foreground="#94A3B8" />
                                        <Run Text="{Binding SpawnNamesDisplay, Mode=OneWay}" FontWeight="Bold" />
                                    </TextBlock>
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Content="Install Mod Now"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="22,10"
                                        Command="{Binding DataContext.InstallModCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DockPanel>

                            <!-- Compatibility Verdict Banner -->
                            <Border Background="{Binding Compatibility.Severity, Converter={StaticResource SeverityToBrush}}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Compatibility.Headline}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" />
                                    <ItemsControl ItemsSource="{Binding Compatibility.Details}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#F1F5F9" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- AI Summary -->
                            <TextBlock Text="AI README &amp; Binary Inspection Summary" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" FontSize="12.5" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AiReasoningSummary}" Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <!-- Security Findings & Warnings -->
                            <ItemsControl ItemsSource="{Binding SecurityFindings}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
                                            <TextBlock Foreground="#FECACA" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="[SECURITY BLOCK] " FontWeight="Bold" />
                                                <Run Text="{Binding FilePath, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding Reason, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" Foreground="#FDE68A" FontSize="12" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#422006" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
                                            <TextBlock Foreground="#FEF08A" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="[CONFLICT DETECTED] " FontWeight="Bold" />
                                                <Run Text="{Binding Description, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Planned Operations Table -->
                            <TextBlock Text="Pre-Install File Preview — File Names, Target Paths &amp; Conflict / Replacement Status" FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="13" Margin="0,4,0,6" />
                            <DataGrid ItemsSource="{Binding Steps}"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      MaxHeight="300"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Include" Width="62">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelectedForInstall, Mode=OneWay}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Command="{Binding DataContext.ToggleStepIncludedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="155" />
                                    <DataGridTextColumn Header="Format / Kind" Binding="{Binding AssetFormatLabel}" Width="185" />
                                    <DataGridTextColumn Header="Safe Target Path / RPF7 Archive" Binding="{Binding FullPreviewDestination}" Width="330" />
                                    <DataGridTextColumn Header="Mapped Via" Binding="{Binding ResolutionSource}" Width="165" />
                                    <DataGridTextColumn Header="Conflict / Backup Status" Binding="{Binding ConflictStatusPreview}" Width="220" />
                                    <DataGridTemplateColumn Header="Target Status / Override" Width="155">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <!-- Shown on non-RPF steps (Add-On dlc.rpf copy, dlclist.xml, scripts) that are 100% auto-mapped -->
                                                    <TextBlock Text="Auto-Mapped ✓"
                                                               Foreground="{StaticResource AccentEmeraldBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanChooseCustomRpfTarget}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Shown only on RPF injection steps: "Override RPF..." when already auto-mapped, or amber "Choose RPF..." when genuinely uncertain -->
                                                    <Button Content="{Binding TargetActionButtonLabel, Mode=OneWay}"
                                                            Padding="8,3"
                                                            Visibility="{Binding CanChooseCustomRpfTarget, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ChooseStepRpfTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RequiresUserTargetSelection}" Value="True">
                                                                        <Setter Property="Background" Value="#B45309" />
                                                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                                                        <Setter Property="Foreground" Value="#FEF3C7" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Extracted README Excerpt or AI Deep File Dossier -->
                            <Expander Header="View Extracted Mod README / AI Deep File Inspection Dossier" Foreground="{StaticResource TextSecondaryBrush}">
                                <Border Background="#0B0F17" BorderBrush="#283548" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                    <TextBox Text="{Binding ReadmeExcerpt, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="#CBD5E1"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             MaxHeight="200"
                                             VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== VIEW 2: INSTALLED MODS & PROFILES ==================== -->
            <Grid Visibility="{Binding IsInstalledModsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Installed Mods &amp; Non-Destructive Profile Toggles" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Disable any mod to move its files safely into non-destructive stash and clean dlclist.xml without losing a single file."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding InstalledMods}"
                          SelectedItem="{Binding SelectedInstalledMod}"
                          Style="{StaticResource DarkDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="State" Binding="{Binding IsEnabled, Converter={StaticResource EnabledToStatusText}}" Width="150" />
                        <DataGridTextColumn Header="Mod Name" Binding="{Binding Name}" Width="230" />
                        <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="75" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="165" />
                        <DataGridTextColumn Header="Verification" Binding="{Binding VerificationState}" Width="165" />
                        <DataGridTextColumn Header="Ops" Binding="{Binding FileCount}" Width="60" />
                        <DataGridTextColumn Header="Installed (UTC)" Binding="{Binding InstalledAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="135" />
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding IsEnabled, Converter={StaticResource EnabledToToggleAction}}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,4"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.ToggleModEnabledCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Commit .OIV"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,4"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding GeneratedOivPath, Converter={StaticResource NullToVis}}"
                                                Command="{Binding DataContext.CommitOpenIvForModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Rollback / Uninstall"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="10,4"
                                                Command="{Binding DataContext.UninstallModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ==================== VIEW 3: VERIFIED BACKUPS & RESTORE ==================== -->
            <Grid Visibility="{Binding IsBackupsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="SHA-256 Verified Backups &amp; One-Click Restore" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Automatic snapshots are created and verified before every mod install, uninstall, and profile switch."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Create Manual Backup"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding CreateBackupCommand}" />
                        <Button Content="Restore Selected Snapshot"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="14,8"
                                Command="{Binding RestoreBackupCommand}" />
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Backups}"
                          SelectedItem="{Binding SelectedBackup}"
                          Style="{StaticResource DarkDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Backup Label" Binding="{Binding Label}" Width="280" />
                        <DataGridTextColumn Header="Type" Binding="{Binding BackupType}" Width="130" />
                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="65" />
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="95" />
                        <DataGridTextColumn Header="SHA-256 Verified" Binding="{Binding IsVerified}" Width="120" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155" />
                        <DataGridTextColumn Header="Verification Proof" Binding="{Binding Notes}" Width="*" />
                        <DataGridTemplateColumn Header="Manage" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Verify Now"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,4"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.VerifyBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Delete"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="10,4"
                                                Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ==================== VIEW 4: DETAILED AUDIT LOGS ==================== -->
            <Grid Visibility="{Binding IsLogsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Detailed Verification &amp; Audit Logs" FontSize="18" FontWeight="Bold" Margin="0,0,18,0" VerticalAlignment="Center" />
                        <TextBlock Text="Level:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="120"
                                  ItemsSource="{Binding LogLevelFilterOptions}"
                                  SelectedItem="{Binding SelectedLogLevelFilter}"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,12,0" />
                        <TextBlock Text="Filter:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="240"
                                 Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBoxStyle}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Content="Export Logs (.log)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportLogsCommand}" />
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredLogs}"
                          Style="{StaticResource DarkDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding FormattedTimestamp}" Width="175" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="95" />
                        <DataGridTextColumn Header="Subsystem" Binding="{Binding Category}" Width="120" />
                        <DataGridTextColumn Header="Event Message" Binding="{Binding Message}" Width="430" />
                        <DataGridTextColumn Header="Verification / Proof Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ==================== VIEW 5: AI & SAFETY SETTINGS ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsAiSettingsTab, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        MaxWidth="780"
                        HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="AI README Analyzer &amp; Safety Configuration" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="GTA Mod Assistant works immediately offline using its built-in GTA V Binary &amp; README Expert Engine, and optionally connects to an OpenAI-compatible LLM or local Ollama model for complex multi-variant human READMEs. API keys are encrypted per-user with Windows DPAPI (or read from GTAMA_AI_API_KEY) and are NEVER stored in plaintext or source code."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18" />

                        <CheckBox Content="Enable Hybrid LLM README Analysis (validated by deterministic GTA V Path Safety Guard)"
                                  IsChecked="{Binding EnableAiLlm}"
                                  Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Local Ollama Preset (Free, Offline)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Command="{Binding UseLocalOllamaPresetCommand}" />
                            <Button Content="OpenAI Preset (gpt-4o-mini)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Command="{Binding UseOpenAiPresetCommand}" />
                            <Button Content="Groq Preset (llama-3.3-70b)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding UseGroqPresetCommand}" />
                        </StackPanel>

                        <TextBlock Text="OpenAI-Compatible Chat Completions Endpoint URL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AiEndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Model Identifier (e.g. gpt-4o-mini, llama3.1, qwen2.5-coder)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AiModelName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Optional API Key (Stored Only in Windows DPAPI User Vault — Leave Blank to Keep Existing)"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     Background="#0F172A"
                                     Foreground="#F8FAFC"
                                     BorderBrush="#283548"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     Margin="0,0,0,6" />
                        <TextBlock Margin="0,0,0,16" FontSize="12" Foreground="{StaticResource AccentEmeraldBrush}">
                            <Run Text="API Key Currently Configured (Env or DPAPI): " Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding HasConfiguredApiKey, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>

                        <CheckBox Content="Automatically launch OpenIV Package Installer (.oiv) when target RPF7 uses Rockstar NG encryption"
                                  IsChecked="{Binding AutoLaunchOpenIvOnEncryptedRpf}"
                                  Margin="0,0,0,20" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save AI &amp; Safety Settings"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,10,0"
                                    Click="OnSaveAiSettingsClick" />
                            <Button Content="Clear Stored API Key"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="OnClearApiKeyClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ==================== VIEW 6: SAFE MEMORY & JUNK CLEANUP ==================== -->
            <Grid Visibility="{Binding IsCleanupTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header + Action Buttons -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Safe Memory &amp; Modding Junk Cleaner" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding CleanupSummaryHeadline}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Rescan Junk &amp; RAM"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding ScanCleanupCommand}" />
                        <Button Content="Quick Trim Idle RAM Only"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding QuickTrimRamOnlyCommand}" />
                        <Button Content="Clean Selected Junk &amp; Trim RAM"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExecuteCleanupCommand}" />
                    </StackPanel>
                </DockPanel>

                <!-- Live RAM + Drive Space + Hard Safety Guarantee Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="PHYSICAL SYSTEM RAM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding MemorySnapshot.RamSummaryDisplay, Mode=OneWay}"
                                       FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="GTA V DRIVE FREE SPACE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding MemorySnapshot.DriveSummaryDisplay, Mode=OneWay}"
                                       FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#0F291E" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="100% PROTECTED — NEVER TOUCHED BY CLEANUP" FontSize="11" FontWeight="Bold" Foreground="#6EE7B7" />
                            <TextBlock Text="GTA V Vanilla Files • mods\ Folder • Active Mod Backups &amp; Profiles • Windows Boot &amp; System Memory Settings"
                                       FontSize="12" Foreground="#ECFDF5" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Itemized Cleanup Categories Table -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding CleanupCategories}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Clean" Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Command="{Binding DataContext.ToggleCleanupCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Cleanup Target" Binding="{Binding Title}" Width="260" />
                        <DataGridTextColumn Header="Items Found" Binding="{Binding CountDisplay}" Width="140" />
                        <DataGridTextColumn Header="Reclaimable" Binding="{Binding SizeDisplay}" Width="125" />
                        <DataGridTextColumn Header="What Gets Cleaned" Binding="{Binding Description}" Width="330" />
                        <DataGridTextColumn Header="Safety Guarantee" Binding="{Binding SafetyGuarantee}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ROW 3: REAL-TIME PROGRESS & VERIFICATION FOOTER -->
        <Border Grid.Row="3"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                             Height="14"
                             Background="#0F172A"
                             Foreground="{StaticResource AccentEmeraldBrush}"
                             BorderBrush="#334155"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressStage}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ProgressDetail}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Safe Mode: mods/ Isolation • Zero Auto-Exec • SHA-256 Verified"
                           FontSize="11.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- FULL-WINDOW DRAG-AND-DROP GLOW OVERLAY -->
        <Border x:Name="DragDropOverlay"
                Grid.RowSpan="4"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Background="#DD0B0F17"
                BorderBrush="{StaticResource AccentEmeraldBrush}"
                BorderThickness="3"
                Margin="10"
                CornerRadius="12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="DROP MOD TO ANALYZE WITH AI"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource AccentEmeraldBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Supports .ZIP, .RAR, .OIV, .7Z archives and extracted GTA V mod folders"
                           FontSize="15"
                           Foreground="#E2E8F0"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
