<Window x:Class="GTAModAssistant.App.Views.ConflictResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod Conflict Detected"
        Width="620"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0F172A">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderBlock"
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="#F59E0B"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Choose how GTA Mod Assistant should resolve these file / RPF7 archive conflicts. Selecting 'Backup &amp; Overwrite' stashes the previous mod's files so rolling back restores them intact."
                   Foreground="#CBD5E1"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Border Grid.Row="2"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,16">
            <ListBox x:Name="ConflictList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#F8FAFC">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding TargetKey}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12.5" />
                            <TextBlock Text="{Binding Description}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel Install"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="OnCancelClick" />
            <Button x:Name="KeepFirstDupButton"
                    Content="Keep First Duplicate Only"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="OnKeepFirstDuplicateClick" />
            <Button Content="Skip Conflicting Files"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="OnSkipClick" />
            <Button Content="Backup &amp; Overwrite"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnOverwriteClick" />
        </StackPanel>
    </Grid>
</Window>
