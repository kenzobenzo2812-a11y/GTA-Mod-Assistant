<Window x:Class="GTAModAssistant.App.Views.AssetPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texture &amp; Model Preview"
        Width="1050"
        Height="650"
        MinWidth="780"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        Foreground="#E2E8F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Local image previews and GTA V asset-header inspection. Native .yft/.ytd rendering is not supported."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="#94A3B8" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="AssetsGrid"
                      ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="OnAssetSelectionChanged"
                      Background="#111827"
                      Foreground="#E2E8F0"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Asset" Binding="{Binding RelativePath}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="155" />
                    <DataGridTextColumn Header="Size (bytes)" Binding="{Binding SizeBytes}" Width="95" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="#111827" BorderBrush="#334155" BorderThickness="1" Margin="12,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </ScrollViewer>
                    <TextBlock x:Name="DetailsText"
                               Grid.Row="1"
                               Text="Select an asset to inspect."
                               TextWrapping="Wrap"
                               Foreground="#CBD5E1"
                               Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
        <Button Grid.Row="2"
                Content="Close"
                HorizontalAlignment="Right"
                MinWidth="90"
                Margin="0,12,0,0"
                Padding="12,6"
                Click="OnCloseClick" />
    </Grid>
</Window>
