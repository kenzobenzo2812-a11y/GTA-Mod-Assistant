<Window x:Class="GTAModAssistant.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Operation"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Border BorderBrush="#334155" BorderThickness="1" Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleBlock"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       Margin="0,0,0,10" />
            <TextBlock x:Name="MessageBlock"
                       FontSize="13.5"
                       Foreground="#CBD5E1"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,22" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="105"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button x:Name="ConfirmBtn"
                        Content="Confirm"
                        Style="{StaticResource DangerButtonStyle}"
                        MinWidth="125"
                        Padding="16,8"
                        Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
