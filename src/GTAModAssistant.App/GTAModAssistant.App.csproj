    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GTAModAssistant.App</RootNamespace>
    <AssemblyName>GTAModAssistant</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
